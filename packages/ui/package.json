{
  "name": "@ex-mio/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Design tokens (CSS variables) and the base components, with Storybook.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./tailwind-preset": {
      "types": "./tailwind-preset.d.cts",
      "default": "./tailwind-preset.cjs"
    }
  },
  "nx": {
    "tags": [
      "type:lib",
      "scope:shared"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src .storybook --max-warnings=0",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:no-raw-colors": "node scripts/check-no-raw-colors.mjs",
    "test": "pnpm run check:contrast && pnpm run check:no-raw-colors && vitest run --maxWorkers=2",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.3.8",
    "vitest": "~4.1.12"
  },
  "author": "maxml",
  "license": "MIT"
}
