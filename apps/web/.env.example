# apps/web — local dev only (`next dev`). Production images are domain-agnostic:
# the browser talks to the API on the same origin and the server reads API_URL at
# runtime, so nothing here is baked into a prod image.

# Dev cross-origin: web runs on :3000, API on :4000, so the browser needs the
# absolute API URL. `next dev` inlines this; SSR falls back to it when API_URL
# is unset. Leave unset in a same-origin (single-host) deployment.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional. Server-side (SSR) base for web -> API calls, read at RUNTIME (not
# inlined). In prod this is the INTERNAL API URL (e.g. http://api:4000). Locally
# it defaults to NEXT_PUBLIC_API_URL above.
# API_URL=http://localhost:4000

# Optional. Browser API base served by the runtime /config endpoint. Empty means
# "same origin"; set only for single_host:false / cross-origin browser access.
# PUBLIC_API_URL=

# Web BFF (app/api/[...path]): the internal URLs of the services it calls, read at RUNTIME, server-side only.
# NEXT_PUBLIC_MIO_API=http selects the BFF-backed adapter; unset keeps the in-memory mock.
# Build time (inlined by `next build`). Compose builds with `http` unless MIO_API=mock is set.
# IDENTITY_URL=http://identity:4001
# PAYMENTS_URL=http://payments:4003
# ENGAGEMENT_URL=http://engagement:4002
# Optional: the wheel the widget shows (known-gaps G-3) and the sandbox casino demo (known-gaps G-10).
# MIO_WHEEL_ID=
# CASINO_SIM_URL=
# MIO_SANDBOX_TARGET_URL=
# MIO_SANDBOX_SECRET=
# MIO_SANDBOX_PLAYER_ID=
