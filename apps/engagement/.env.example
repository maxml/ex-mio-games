# Runtime
NODE_ENV=development
PORT=4002
LOG_LEVEL=info

# This service's own database, with two roles (created by docker/postgres/init.sh):
# the runtime role (not the table owner, no DDL, no superuser, subject to row-level
# security) for the app, and the owner role for `node dist/migrate.js` only.
DATABASE_URL=postgresql://engagement_app:engagement-app-dev@localhost:54329/engagement
MIGRATION_DATABASE_URL=postgresql://engagement_owner:engagement-owner-dev@localhost:54329/engagement

# Postgres TLS: disable | require | verify-full. Off by default outside production.
# In production it must be stated explicitly: a self-hosted Postgres without TLS
# says DATABASE_SSL=disable; a managed one says require (or verify-full plus
# DATABASE_CA_CERT_PATH). sslmode in the URL is honoured only when this is unset.
# DATABASE_SSL=disable

AMQP_URL=amqp://mio:mio-dev@localhost:55672

# Optional. In production the URL must use TLS (rediss://).
REDIS_URL=redis://localhost:56379

# Identity (JWKS, tenant status, service tokens) and this service's client-credentials secret (D-4).
IDENTITY_URL=http://localhost:4001
SERVICE_CLIENT_SECRET=engagement-dev-secret-0000

# Payments base URL: the redemption saga reserves, commits and releases coins through it.
PAYMENTS_URL=http://localhost:4003

# Deploy plane injects these (shown in /healthz and in every log line).
# SERVICE_NAME=engagement
# APP_VERSION=
# GIT_SHA=
