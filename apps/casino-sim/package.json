{
  "name": "@ex-mio/casino-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Simulates two partner casinos with different integration styles, plus fault injection, for local runs and tests.",
  "main": "dist/main.js",
  "nx": {
    "tags": [
      "type:app",
      "scope:casino-sim"
    ]
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings=0",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@ex-mio/contracts": "workspace:^1.0.0",
    "@ex-mio/logger": "workspace:^1.0.0",
    "dotenv": "^16.4.5",
    "fastify": "5.8.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "jest": "^30.0.2",
    "ts-jest": "^29.4.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).ts"
    ],
    "moduleNameMapper": {
      "^@ex-mio/contracts$": "<rootDir>/../../packages/contracts/src",
      "^@ex-mio/logger$": "<rootDir>/../../packages/logger/src"
    },
    "clearMocks": true
  },
  "author": "maxml",
  "license": "MIT"
}
