# Runtime
NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# This service's own database and role (created by docker/postgres/init.sh).
# The role is not a superuser and does not bypass row-level security.
DATABASE_URL=postgresql://identity:identity-dev@localhost:54329/identity

# Postgres TLS: disable | require | verify-full. Off by default outside production.
# In production it must be stated explicitly: a self-hosted Postgres without TLS
# says DATABASE_SSL=disable; a managed one says require (or verify-full plus
# DATABASE_CA_CERT_PATH). sslmode in the URL is honoured only when this is unset.
# DATABASE_SSL=disable

AMQP_URL=amqp://mio:mio-dev@localhost:55672

# Tenants are <slug>.<BASE_DOMAIN>; the platform tenant is platform.<BASE_DOMAIN>.
BASE_DOMAIN=mio.localhost

# The platform admin, seeded at boot (idempotent). Use real values outside local development.
PLATFORM_ADMIN_EMAIL=root@mio.test
PLATFORM_ADMIN_PASSWORD=platform-dev-password-0000

# Key-encryption key for integration secrets and the signing keys at rest (16+ characters).
CREDENTIALS_KEK=dev-credentials-kek-0000000000

# Service-to-service client registry (JSON: service name -> secret). Each caller holds its own
# secret as SERVICE_CLIENT_SECRET (see the engagement and payments .env.example).
SERVICE_CLIENT_SECRETS={"engagement":"engagement-dev-secret-0000","payments":"payments-dev-secret-00000"}

# Identity provider: firebase-emulator (default in compose, demo project) or fake (in-memory).
IDENTITY_PROVIDER=firebase-emulator
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT=demo-ex-mio

# Deploy plane injects these (shown in /healthz and in every log line).
# SERVICE_NAME=identity
# APP_VERSION=
# GIT_SHA=
