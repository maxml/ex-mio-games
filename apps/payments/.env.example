# Runtime
NODE_ENV=development
PORT=4003
LOG_LEVEL=info

# This service's own database, with two roles (created by docker/postgres/init.sh):
# the runtime role (not the table owner, no DDL, no superuser, subject to row-level
# security) for the app, and the owner role for `node dist/migrate.js` only.
DATABASE_URL=postgresql://payments_app:payments-app-dev@localhost:54329/payments
MIGRATION_DATABASE_URL=postgresql://payments_owner:payments-owner-dev@localhost:54329/payments

# Postgres TLS: disable | require | verify-full. Off by default outside production.
# In production it must be stated explicitly: a self-hosted Postgres without TLS
# says DATABASE_SSL=disable; a managed one says require (or verify-full plus
# DATABASE_CA_CERT_PATH). sslmode in the URL is honoured only when this is unset.
# DATABASE_SSL=disable

AMQP_URL=amqp://mio:mio-dev@localhost:55672

# Identity: JWKS and tenant status for the service auth entry point, and this service's
# client-credentials secret (D-4).
IDENTITY_URL=http://localhost:4001
SERVICE_CLIENT_SECRET=payments-dev-secret-00000

# Webhook secret of the fake payment provider. REQUIRED in production (at least 32 characters, no
# default in the source: the process refuses to start without it). Development without it gets a
# random secret per process, so no webhook can be signed.
FAKE_PROVIDER_WEBHOOK_SECRET=dev-fake-provider-webhook-secret-0000

# Seconds between two passes of the worker's ledger jobs (reconciliation, usage report). 0 = off.
# `node dist/ledger-report.js` (`pnpm ledger:report`) runs one pass by hand.
LEDGER_JOBS_INTERVAL_SECONDS=3600

# Deploy plane injects these (shown in /healthz and in every log line).
# SERVICE_NAME=payments
# APP_VERSION=
# GIT_SHA=
