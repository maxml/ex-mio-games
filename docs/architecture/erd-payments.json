  "cards": [
    {
      "dot": "cyan",
      "title": "Row-level security",
      "items": [
        "every business table with tenant_id has ENABLE + FORCE RLS (17 of 19), plus audit_intents",
        "no RLS: billing_plans (global), reconciliation_tenants, outbox and inbox"
      ]
    },
    {
      "dot": "amber",
      "title": "Keys and environment",
      "items": [
        "sandbox on wallets, accounts and wallet_owner_links; unique (tenant_id, user_id, sandbox) on wallet_owner_links"
      ]
    },
    {
      "dot": "slate",
      "title": "Across databases",
      "items": [
        "wallet_owner_links.user_id is a logical key into identity users, not a foreign key (erasure deletes the link)",
        "tenant_id in every table is a logical key into identity tenants",
        "a link into another service database is a logical id, never a foreign key",
        "solid line: a declared foreign key; dashed line: a logical link the database does not enforce"
      ]
    }
  ]
