  "cards": [
    {
      "dot": "cyan",
      "title": "Row-level security",
      "items": [
        "tenants: ENABLE without FORCE, scoped on id; every other tenant_id table has ENABLE + FORCE",
        "signing_keys, outbox and inbox have no RLS: they are not tenant data or work across tenants"
      ]
    },
    {
      "dot": "amber",
      "title": "Keys and environment",
      "items": [
        "sandbox on launch_jti (key part); integration_credentials and reward_apis use environment text (production or sandbox)"
      ]
    },
    {
      "dot": "slate",
      "title": "Across databases",
      "items": [
        "a link into another service database is a logical id, never a foreign key",
        "solid line: a declared foreign key; dashed line: a logical link the database does not enforce"
      ]
    }
  ]
