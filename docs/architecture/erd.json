{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "title": "Schema overview: 3 databases, 50 tables",
    "subtitle": "identity 13, engagement 15, payments 22 (41 business tables and 3 shared outbox, inbox, audit_intents per database). Full per-database diagrams: erd-identity.html, erd-engagement.html, erd-payments.html",
    "output": "erd.html",
    "quality_profile": "standard"
  },
  "layout": { "mode": "grid", "gapX": 90, "gapY": 60, "entityW": 300 },
  "entities": [
    {
      "id": "tenants",
      "label": "tenants",
      "sublabel": "RLS on, not forced",
      "tag": "identity database",
      "row": 0,
      "col": 0,
      "attributes": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "slug", "type": "text", "key": "uk" },
        { "name": "type", "type": "text" },
        { "name": "status", "type": "text" }
      ]
    },
    {
      "id": "users",
      "label": "users",
      "sublabel": "RLS forced",
      "tag": "identity database",
      "row": 0,
      "col": 1,
      "attributes": [
        { "name": "tenant_id", "type": "uuid", "key": ["pk", "fk"], "references": "tenants.id" },
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "kind", "type": "text" }
      ]
    },
    {
      "id": "player_links",
      "label": "player_links",
      "sublabel": "RLS forced",
      "tag": "identity database",
      "row": 0,
      "col": 2,
      "attributes": [
        {
          "name": "tenant_id",
          "type": "uuid",
          "key": ["pk", "fk"],
          "references": "users.tenant_id"
        },
        { "name": "user_id", "type": "uuid", "key": ["pk", "fk"], "references": "users.id" },
        { "name": "platform", "type": "text", "key": "uk" },
        { "name": "external_player_id", "type": "text", "key": "uk" }
      ]
    },
    {
      "id": "tenant_projections",
      "label": "tenant_projections",
      "sublabel": "RLS forced",
      "tag": "engagement database",
      "row": 1,
      "col": 0,
      "attributes": [
        { "name": "tenant_id", "type": "uuid, logical: tenants.id", "key": "pk" },
        { "name": "slug", "type": "text" }
      ]
    },
    {
      "id": "spin_credits",
      "label": "spin_credits",
      "sublabel": "RLS forced, sandbox",
      "tag": "engagement database",
      "row": 1,
      "col": 1,
      "attributes": [
        { "name": "tenant_id", "type": "uuid", "key": "pk" },
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "user_id", "type": "uuid, logical: users.id" },
        { "name": "sandbox", "type": "boolean" }
      ]
    },
    {
      "id": "redemptions",
      "label": "redemptions",
      "sublabel": "RLS forced, sandbox",
      "tag": "engagement database",
      "row": 1,
      "col": 2,
      "attributes": [
        { "name": "tenant_id", "type": "uuid", "key": "pk" },
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "player_id", "type": "text, logical: users.id" },
        { "name": "sandbox", "type": "boolean" },
        { "name": "state", "type": "text" }
      ]
    },
    {
      "id": "wallet_owner_links",
      "label": "wallet_owner_links",
      "sublabel": "RLS forced, sandbox",
      "tag": "payments database",
      "row": 2,
      "col": 1,
      "attributes": [
        {
          "name": "tenant_id",
          "type": "uuid",
          "key": ["pk", "fk"],
          "references": "wallets.tenant_id"
        },
        { "name": "wallet_id", "type": "uuid", "key": ["pk", "fk"], "references": "wallets.id" },
        { "name": "user_id", "type": "uuid, logical: users.id", "key": "uk" },
        { "name": "sandbox", "type": "boolean", "key": "uk" }
      ]
    },
    {
      "id": "wallets",
      "label": "wallets",
      "sublabel": "RLS forced, sandbox",
      "tag": "payments database",
      "row": 2,
      "col": 2,
      "attributes": [
        { "name": "tenant_id", "type": "uuid", "key": "pk" },
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "sandbox", "type": "boolean" }
      ]
    }
  ],
  "relationships": [
    {
      "id": "users_tenants",
      "from": "users",
      "to": "tenants",
      "label": "belongs to",
      "fromCardinality": "many",
      "toCardinality": "one",
      "identifying": true
    },
    {
      "id": "links_users",
      "from": "player_links",
      "to": "users",
      "label": "maps to",
      "fromCardinality": "many",
      "toCardinality": "one",
      "identifying": true
    },
    {
      "id": "owner_wallets",
      "from": "wallet_owner_links",
      "to": "wallets",
      "label": "owner of",
      "fromCardinality": "many",
      "toCardinality": "one",
      "identifying": true
    },
    {
      "id": "logical_projection_tenant",
      "from": "tenant_projections",
      "to": "tenants",
      "label": "event copy, no FK",
      "fromCardinality": "one",
      "toCardinality": "one",
      "identifying": false,
      "variant": "dashed"
    },
    {
      "id": "logical_credit_user",
      "from": "spin_credits",
      "to": "users",
      "label": "user_id, no FK",
      "fromCardinality": "many",
      "toCardinality": "one",
      "identifying": false,
      "variant": "dashed"
    },
    {
      "id": "logical_redemption_user",
      "from": "redemptions",
      "to": "users",
      "label": "player_id, no FK",
      "fromCardinality": "many",
      "toCardinality": "one",
      "identifying": false,
      "variant": "dashed"
    },
    {
      "id": "logical_owner_user",
      "from": "wallet_owner_links",
      "to": "users",
      "label": "user_id, no FK",
      "fromCardinality": "many",
      "toCardinality": "one",
      "identifying": false,
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Three databases",
      "items": [
        "identity 13 tables, engagement 15, payments 22 (50 in all, without the TypeORM migrations table)",
        "each service owns its database; the 41 business tables plus outbox, inbox and audit_intents per database",
        "open erd-identity.html, erd-engagement.html and erd-payments.html for every table"
      ]
    },
    {
      "dot": "amber",
      "title": "Tenancy and sandbox",
      "items": [
        "every table with tenant_id has ENABLE + FORCE RLS, except tenants (ENABLE only), outbox, inbox and reconciliation_tenants",
        "no RLS: outbox, inbox (x3), signing_keys, billing_plans, reconciliation_tenants",
        "sandbox column: launch_jti, inbound_events, spin_credits, item_player_usage, redemptions, wallets, accounts, wallet_owner_links"
      ]
    },
    {
      "dot": "slate",
      "title": "Across databases",
      "items": [
        "dashed lines are logical ids carried between services, never foreign keys",
        "tenant_id is a logical key into identity tenants in every database",
        "the ids cross by event or by an internal call, so each database stays independent"
      ]
    }
  ]
}
