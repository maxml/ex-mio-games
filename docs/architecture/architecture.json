  "cards": [
    {
      "dot": "cyan",
      "title": "Services and modules",
      "items": [
        "identity, engagement, payments are services",
        "tenants live inside identity, integrations inside engagement",
        "modules sit behind Nx boundaries and can be promoted later"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data and messaging",
      "items": [
        "one Postgres container, one database per service (owner and app roles), tenant_id and RLS",
        "RabbitMQ topic exchange, routing key = event type, outbox and inbox in every service",
        "payments and the other services check tokens with identity (JWKS)",
        "Redis holds an optional balance projection, never the source of truth for money"
      ]
    },
    {
      "dot": "amber",
      "title": "Money",
      "items": [
        "only payments writes coins",
        "balance is readable from any service",
        "redemption is a saga across engagement and payments"
      ]
    },
    {
      "dot": "slate",
      "title": "Not drawn",
      "items": [
        "web also reads balances from payments (REST); nothing calls Varta at runtime",
        "Deckhand deploys every container",
        "Stripe adapter and production identity provider are designed only"
      ]
    }
