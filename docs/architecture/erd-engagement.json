  "cards": [
    {
      "dot": "cyan",
      "title": "Row-level security",
      "items": [
        "one declared foreign key: spins to spin_credits; the other links are logical (dashed), not enforced",
        "every business table has ENABLE + FORCE RLS; outbox and inbox have none"
      ]
    },
    {
      "dot": "amber",
      "title": "Keys and environment",
      "items": [
        "sandbox is part of the key on inbound_events, item_player_usage and redemptions (unique), and a column on spin_credits"
      ]
    },
    {
      "dot": "slate",
      "title": "Across databases",
      "items": [
        "spin_credits.user_id and redemptions.player_id are logical keys into identity users",
        "tenant_projections is an event-fed copy of identity tenants (identity.tenant.created)",
        "a link into another service database is a logical id, never a foreign key",
        "solid line: a declared foreign key; dashed line: a logical link the database does not enforce"
      ]
    }
  ]
