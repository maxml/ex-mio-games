  "cards": [
    { "dot": "cyan", "title": "Ingest", "items": ["signature, timestamp window and schema are checked before anything else", "a duplicate event id returns the original result and creates no second spin", "the player is resolved through identity, never by a client field"] },
    { "dot": "amber", "title": "Spin and ledger", "items": ["the outcome comes from a server secret and a versioned weight table", "one conditional update consumes the spin credit", "the coin credit uses the spin id as operation id"] },
