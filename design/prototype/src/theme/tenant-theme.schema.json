{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MIO tenant theme",
  "description": "Overrides for MIO semantic tokens. Any token not listed keeps the default from tokens.css.",
  "type": "object",
  "required": ["id", "name", "tokens"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(bg|surface|surface-2|border|input-border|fg|fg-muted|primary|primary-fg|accent|accent-fg|ring|success|warning|danger|info|coin|wheel-[1-6]|wheel-fg|wheel-rim)$": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "^(radius-sm|radius-md|radius-lg)$": { "type": "string", "pattern": "^[0-9]+px$" },
        "^(font-sans|font-display|shadow-card)$": { "type": "string" }
      }
    }
  }
}
