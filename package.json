{
  "name": "ex-mio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down -v",
    "build": "pnpm nx run-many -t build",
    "lint": "pnpm nx run-many -t lint",
    "lint:fsd": "steiger apps/web/src/layers",
    "typecheck": "pnpm nx run-many -t typecheck",
    "test": "pnpm nx run-many -t test",
    "test:compose": "pnpm --filter @ex-mio/compose-tests test:compose",
    "storybook": "pnpm --filter @ex-mio/ui storybook",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,md,yml,yaml,css}\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@nx/eslint": "^22.7.12",
    "@nx/eslint-plugin": "22.7.12",
    "@nx/jest": "^22.7.12",
    "@nx/js": "^22.7.12",
    "@nx/next": "^22.7.12",
    "@nx/plugin": "^22.7.12",
    "@nx/vite": "^22.7.12",
    "@nx/web": "22.7.12",
    "@swc-node/register": "~1.12.1",
    "@swc/cli": "~0.8.2",
    "@swc/core": "~1.16.22",
    "@swc/helpers": "~0.5.24",
    "@types/jest": "^30.0.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/ui": "~4.1.12",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.6",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "jest-util": "^30.5.1",
    "jiti": "2.7.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^15.2.10",
    "nx": "^22.7.12",
    "postcss": "^8.5.33",
    "prettier": "~3.10.1",
    "steiger": "0.10.0",
    "ts-jest": "^29.4.15",
    "ts-node": "10.9.2",
    "tslib": "^2.9.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.8",
    "vitest": "~4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "author": "maxml",
  "license": "MIT"
}
